# ─── Generated / environment-specific ───────────────────────
uploads/
cache/
wpo-cache/
upgrade/
debug.log

# ─── Backups & exports ───────────────────────────────────────
wpvividbackups/
wpvivid_uploads/
wpvivid_staging/
webtoffee_export/

# ─── Third-party plugins (not custom code) ───────────────────
plugins/*

